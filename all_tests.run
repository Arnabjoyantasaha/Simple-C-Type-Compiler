int fib_a = 0;
int fib_b = 1;
int fib_c = 0;
int fib_i = 0;
print(fib_a);
print(fib_b);
for (fib_i = 2; fib_i <= 7; fib_i = fib_i + 1) {
    fib_c = fib_a + fib_b;
    fib_a = fib_b;
    fib_b = fib_c;
    print(fib_c);
}


int cnt = 0;
int cnum = 36;
int cdivisor = 1;
while (cdivisor <= cnum) {
    int rem = cnum / cdivisor;
    rem = rem * cdivisor;
    if (cnum == rem + (cnum - rem)) {
        cnt = cnt + 1;
    }
    cdivisor = cdivisor + 1;
}
print(cnt);


