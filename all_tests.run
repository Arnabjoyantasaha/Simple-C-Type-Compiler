for (fn = 1; fn <= n; fn = fn + 1) {
    fact = fact * fn;
}
print(fact);


int base = 2;
int exp_val = 8;
int power = 1;
int ep = 0;
for (ep = 1; ep <= exp_val; ep = ep + 1) {
    power = power * base;
}
print(power);


int nm = 7;
switch (nm) {
    case 1: print("one"); break;
    case 7: print("seven"); break;
    default: print("other"); break;
}


